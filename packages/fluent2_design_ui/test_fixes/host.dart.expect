import 'package:flutter/widgets.dart';
import 'package:fluent2_design_ui/fluent2_design_ui.dart';

void main() {
  final day = Fluent2ThemeData.juniper();
  final night = Fluent2ThemeData.juniper(Brightness.dark);
  Fluent2Host(light: day, dark: night, child: const SizedBox());
  RawPalette.contrastRatio(day.colors.neutralForeground1, day.background);
}
