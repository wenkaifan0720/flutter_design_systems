// The names fluent2_design_ui 0.5.0 renames: field_words.dart calls them as before `dart fix --apply`,
// field_words.dart.expect as after.
import 'package:flutter/widgets.dart';
import 'package:fluent2_design_ui/fluent2_design_ui.dart';

void calls(BuildContext context) {
  final v1 = Fluent2FormField(
    labelText: 'Text',
    helperText: 'Text',
    child: const SizedBox(),
  );
  print(v1.labelText);
  print(v1.helperText);
  final v2 = Fluent2TextField(hintText: 'Text');
  print(v2.hintText);
  final v3 = Fluent2TextArea(hintText: 'Text');
  print(v3.hintText);
  final v4 = Fluent2SearchBox(hintText: 'Text');
  print(v4.hintText);
  final v5 = Fluent2SearchEntry(onPressed: () {}, hintText: 'Text');
  print(v5.hintText);
  final v6 = Fluent2PasswordField(hintText: 'Text');
  print(v6.hintText);
  final v7 = Fluent2InputGroup(hintText: 'Text');
  print(v7.hintText);
  final v8 = Fluent2Combobox<String>(
    options: const [],
    value: 'a',
    onChanged: (_) {},
    hintText: 'Text',
  );
  print(v8.hintText);
  final v9 = Fluent2MultiSelect<String>(
    options: const [],
    selected: const [],
    onChanged: (_) {},
    hintText: 'Text',
  );
  print(v9.hintText);
  final v10 = Fluent2DatePicker(
    value: DateTime(2026),
    onChanged: (_) {},
    hintText: 'Text',
  );
  print(v10.hintText);
  final v11 = Fluent2Composer(onSend: (_) {}, hintText: 'Text');
