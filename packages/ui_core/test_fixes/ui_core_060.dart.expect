void uses(
  BuildContext context,
  AnimationController controller,
  SpringDescription spring,
  MenuSerializableShortcut shortcut,
) {
  rawReduceMotionOf(context);
  rawSpring(dampingRatio: 1, stiffness: 400);
  rawSpringSimulation(spring, from: 0, to: 1);
  rawMatchScore('Save', 'sa');
  rawShortcutKeys(context, shortcut);
  rawShortcutLabel(context, shortcut);
  rawSwipeBack(const {});
  showRawCommandPalette(
    context: context,
    palette: (run) => throw UnimplementedError(),
  );
  RawSpringDrive(controller).springTo(1, spring);
}

const Tolerance tolerance = rawSpringTolerance;
